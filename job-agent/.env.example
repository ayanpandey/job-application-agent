# ==========================================
# Job Agent - environment variables
#
# Copy to .env (gitignored) and fill in the one key you need. Never commit .env.
# ==========================================

# Which model backend to use when running from source.
#   gemini | openai | groq | ollama   -- call the provider directly with your own key
#   proxy                             -- go through a licence server you deployed
#                                        (see ../license-server/README.md)
LLM_PROVIDER=gemini

# API key for the provider chosen above (only that one is read).
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Gemini on Vertex AI instead of an API key: path to a service-account JSON
# kept OUTSIDE this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/service_account.json

# Ollama host, for local models.
OLLAMA_BASE_URL=http://localhost:11434
